# Dot directories: only standard .github/ content and .agents/skills/ are tracked
.*/
!/.github/
/.github/*/
!/.github/workflows/
!/.github/actions/
!/.github/ISSUE_TEMPLATE/
!/.github/PULL_REQUEST_TEMPLATE/
!/.github/DISCUSSION_TEMPLATE/
!/.agents/
/.agents/*
!/.agents/skills/

# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.history
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.flutter-plugins-dependencies
/build/
/coverage/
/test/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Source runner
tools/source-runner/node_modules/

/android/build/

# Local planning notes
docs/superpowers/

# 无关 Agent 配置和个人说明（任意层级，覆盖大小写变体）
.[Cc][Ll][Aa][Uu][Dd][Ee]/
[Cc][Ll][Aa][Uu][Dd][Ee].md
[Cc][Ll][Aa][Uu][Dd][Ee].*.md

# Generated native build files
/ios/Pods/
/ios/Flutter/Generated.xcconfig
/ios/Flutter/flutter_export_environment.sh
/ios/Runner/GeneratedPluginRegistrant.*
/macos/Pods/
/macos/Flutter/ephemeral/
/linux/flutter/ephemeral/
**/xcuserdata/
