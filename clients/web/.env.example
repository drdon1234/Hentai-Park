WEB_SESSION_MODE=local
HOST=127.0.0.1
PORT=8787
WEB_PORT=8787
DATA_DIR=./data
# Server mode requires HTTPS reverse proxy, explicit HOST and both values below.
# WEB_IMAGE=drdon1234/hentai-park:latest
# AUTH_TOKEN=replace-with-at-least-32-random-characters
# WEB_ALLOWED_ORIGIN=https://park.example.org

# Optional instance HTTP(S) CONNECT proxy; TLS host/certificate verification remains active.
# WEB_HTTP_PROXY=http://proxy.example.org:8080
# Explicitly allow a local proxy only when required by this deployment.
# WEB_HTTP_PROXY_ALLOW_LOCAL=true
# Optional: permit RFC 2544 / 5180 benchmark fake-IP ranges (198.18.0.0/15, 2001:2::/48) in server mode when using TUN gateways.
# (Enabled automatically in local loopback mode.)
# WEB_ALLOW_FAKE_IP=true

# Server deployments must explicitly opt in to keyless loopback HTTP AI endpoints.
# Local mode permits only literal loopback/localhost, without credentials.
# WEB_ALLOW_LOCAL_AI=true
