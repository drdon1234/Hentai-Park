# Dot directories: only standard .github/ content and .agents/skills/ are tracked
.*/
!/.github/
/.github/*/
!/.github/workflows/
!/.github/actions/
!/.github/ISSUE_TEMPLATE/
!/.github/PULL_REQUEST_TEMPLATE/
!/.github/DISCUSSION_TEMPLATE/
!/.agents/
/.agents/*
!/.agents/skills/

# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.history
migrate_working_dir/

# 本地凭据与签名材料（示例配置只使用占位符）
.env
.env.*
!.env.example
!.env.sample
key.properties
*.keystore
*.jks
*.p12
*.pfx
*.p8
*.key
*.pem
*.keychain
*.keychain-db
*.mobileprovision
credentials.json
credentials.*.json
cookies.txt
cookies.json
cookies.*.json
session.json
session.*.json
*.session
*.session-journal

# 用户数据、备份与网络抓包
*.parkbak
*.har
*.pcap
*.pcapng
*.bak
/backups/
/logs/

# IntelliJ related
*.iml
*.ipr
*.iws

# Flutter/Dart/Pub related
**/doc/api/
.flutter-plugins-dependencies
/build/
/coverage/
/test/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Source runner
tools/source-runner/node_modules/

/android/build/

# Local planning notes
docs/superpowers/

# 无关 Agent 配置和个人说明（任意层级，覆盖大小写变体）
.[Cc][Ll][Aa][Uu][Dd][Ee]/
[Cc][Ll][Aa][Uu][Dd][Ee].md
[Cc][Ll][Aa][Uu][Dd][Ee].*.md
