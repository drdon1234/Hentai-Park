# Before the first Docker Hub publication, build and use the local image.
WEB_IMAGE=hentai-park-web:local
# After publication: WEB_IMAGE=drdon1234/hentai-park:latest
AUTH_TOKEN=
WEB_ALLOWED_ORIGIN=https://park.example.org
WEB_PORT=8787
# Optional outbound HTTP(S) CONNECT proxy. Enable local access only when needed.
# WEB_HTTP_PROXY=http://proxy.example.org:8080
# WEB_HTTP_PROXY_ALLOW_LOCAL=true
# WEB_ALLOW_LOCAL_AI=true
# Optional bridge subnet, only after checking host/VPN/Docker routes.
# WEB_DOCKER_SUBNET=
# Native execution defaults to local mode. To run a remote native server:
# WEB_SESSION_MODE=server
# HOST=0.0.0.0
