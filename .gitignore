# Dot directories: only standard .github/ content and .agents/skills/ are tracked
.*/
!/.github/
/.github/*/
!/.github/workflows/
!/.github/actions/
!/.github/ISSUE_TEMPLATE/
!/.github/PULL_REQUEST_TEMPLATE/
!/.github/DISCUSSION_TEMPLATE/
!/.agents/
/.agents/*
!/.agents/skills/

# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.history
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.flutter-plugins-dependencies
/build/
/coverage/
/test/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Source runner
tools/source-runner/node_modules/

/android/build/

# Local planning notes
docs/superpowers/

# Personal agent notes
CLAUDE.local.md
